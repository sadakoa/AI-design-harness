{
  "$description": "The only source of values. Two layers: primitives (raw values) and roles. Screens and components use roles only. Name new tokens kind.role.variant, e.g. color.text.on-action. The values here are examples — replace them.",
  "color": {
    "primitive": {
      "blue": {
        "50": {
          "$type": "color",
          "$value": "#eef2ff"
        },
        "600": {
          "$type": "color",
          "$value": "#3b5bdb"
        },
        "700": {
          "$type": "color",
          "$value": "#2f4ac0"
        }
      },
      "gray": {
        "0": {
          "$type": "color",
          "$value": "#ffffff"
        },
        "50": {
          "$type": "color",
          "$value": "#f7f7f8"
        },
        "200": {
          "$type": "color",
          "$value": "#e4e4e7"
        },
        "500": {
          "$type": "color",
          "$value": "#71717a"
        },
        "900": {
          "$type": "color",
          "$value": "#18181b"
        }
      },
      "red": {
        "600": {
          "$type": "color",
          "$value": "#dc2626"
        }
      },
      "green": {
        "600": {
          "$type": "color",
          "$value": "#16a34a"
        }
      },
      "amber": {
        "600": {
          "$type": "color",
          "$value": "#d97706"
        }
      }
    },
    "surface": {
      "base": {
        "$type": "color",
        "$value": "{color.primitive.gray.0}",
        "$description": "Page background"
      },
      "subtle": {
        "$type": "color",
        "$value": "{color.primitive.gray.50}",
        "$description": "A step below the page, for grouping"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.primitive.gray.900}",
        "$description": "Body text and headings"
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.primitive.gray.500}",
        "$description": "Supporting text: dates, counts, hints"
      },
      "on-action": {
        "$type": "color",
        "$value": "{color.primitive.gray.0}",
        "$description": "Text on the primary action color"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{color.primitive.gray.200}",
        "$description": "Dividers and input borders"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.primitive.blue.600}",
        "$description": "Keyboard focus ring"
      }
    },
    "action": {
      "primary": {
        "$type": "color",
        "$value": "{color.primitive.blue.600}",
        "$description": "The primary action. See R-03 in rules.md"
      },
      "primary-hover": {
        "$type": "color",
        "$value": "{color.primitive.blue.700}",
        "$description": "Primary action on hover"
      },
      "primary-subtle": {
        "$type": "color",
        "$value": "{color.primitive.blue.50}",
        "$description": "A light wash of the primary color, e.g. a selected row"
      }
    },
    "status": {
      "danger": {
        "$type": "color",
        "$value": "{color.primitive.red.600}",
        "$description": "Errors and destructive actions"
      },
      "success": {
        "$type": "color",
        "$value": "{color.primitive.green.600}",
        "$description": "Done"
      },
      "warning": {
        "$type": "color",
        "$value": "{color.primitive.amber.600}",
        "$description": "Needs attention"
      }
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "4px"
    },
    "md": {
      "$type": "dimension",
      "$value": "8px"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "font": {
    "family": {
      "base": {
        "$type": "fontFamily",
        "$value": "\"Noto Sans JP\", system-ui, sans-serif"
      }
    },
    "size": {
      "sm": {
        "$type": "dimension",
        "$value": "12px"
      },
      "md": {
        "$type": "dimension",
        "$value": "14px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "16px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "20px"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "24px"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 600
      }
    }
  }
}
