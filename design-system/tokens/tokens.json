{
  "$description": "値の正本。primitive（素の値）と用途の2層。画面と部品は用途の層だけを参照する。名前は「種類.用途.変化」（例：color.text.on-action）。入っている値は例なので差し替える。",
  "color": {
    "primitive": {
      "blue": {
        "50": {
          "$type": "color",
          "$value": "#eef2ff"
        },
        "600": {
          "$type": "color",
          "$value": "#3b5bdb"
        },
        "700": {
          "$type": "color",
          "$value": "#2f4ac0"
        }
      },
      "gray": {
        "0": {
          "$type": "color",
          "$value": "#ffffff"
        },
        "50": {
          "$type": "color",
          "$value": "#f7f7f8"
        },
        "200": {
          "$type": "color",
          "$value": "#e4e4e7"
        },
        "500": {
          "$type": "color",
          "$value": "#71717a"
        },
        "900": {
          "$type": "color",
          "$value": "#18181b"
        }
      },
      "red": {
        "600": {
          "$type": "color",
          "$value": "#dc2626"
        }
      },
      "green": {
        "600": {
          "$type": "color",
          "$value": "#16a34a"
        }
      },
      "amber": {
        "600": {
          "$type": "color",
          "$value": "#d97706"
        }
      }
    },
    "surface": {
      "base": {
        "$type": "color",
        "$value": "{color.primitive.gray.0}",
        "$description": "画面の背景"
      },
      "subtle": {
        "$type": "color",
        "$value": "{color.primitive.gray.50}",
        "$description": "面を一段下げたいとき"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.primitive.gray.900}",
        "$description": "本文・見出し"
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.primitive.gray.500}",
        "$description": "補足・日時・件数"
      },
      "on-action": {
        "$type": "color",
        "$value": "{color.primitive.gray.0}",
        "$description": "主操作の色の上に載せる文字"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{color.primitive.gray.200}",
        "$description": "区切り線・入力欄の枠"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.primitive.blue.600}",
        "$description": "キーボードで選んでいる要素の枠"
      }
    },
    "action": {
      "primary": {
        "$type": "color",
        "$value": "{color.primitive.blue.600}",
        "$description": "主操作の色（使い方は rules.md R-03）"
      },
      "primary-hover": {
        "$type": "color",
        "$value": "{color.primitive.blue.700}",
        "$description": "主操作にポインタが乗ったとき"
      },
      "primary-subtle": {
        "$type": "color",
        "$value": "{color.primitive.blue.50}",
        "$description": "主操作の色を薄く敷くとき（選択中の行など）"
      }
    },
    "status": {
      "danger": {
        "$type": "color",
        "$value": "{color.primitive.red.600}",
        "$description": "エラー・削除"
      },
      "success": {
        "$type": "color",
        "$value": "{color.primitive.green.600}",
        "$description": "完了"
      },
      "warning": {
        "$type": "color",
        "$value": "{color.primitive.amber.600}",
        "$description": "注意"
      }
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "4px"
    },
    "md": {
      "$type": "dimension",
      "$value": "8px"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "font": {
    "family": {
      "base": {
        "$type": "fontFamily",
        "$value": "\"Noto Sans JP\", system-ui, sans-serif"
      }
    },
    "size": {
      "sm": {
        "$type": "dimension",
        "$value": "12px"
      },
      "md": {
        "$type": "dimension",
        "$value": "14px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "16px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "20px"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "24px"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 600
      }
    }
  }
}
